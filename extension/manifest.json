{
  "manifest_version": 3,
  "name": "Trending Context",
  "version": "0.2.0",
  "description": "See daily stars and related public activity inside GitHub Trending.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Trending Context",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://gay00ung.github.io/*"],
  "background": { "service_worker": "worker.js" },
  "content_scripts": [{
    "matches": ["https://github.com/trending*"],
    "js": ["context.js", "content.js"],
    "css": ["content.css"]
  }]
}
